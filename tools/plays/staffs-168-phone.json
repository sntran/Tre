{
 "about": "#168: grade 1, the bamboo staffs: the woodcutter cuts his show at the rings of the sample, the voice counts the rings while the button is down, and the cut is at the ring of the mark at the release.",
 "start": "?story=staffs-grade1",
 "lang": "vi",
 "allow": [
  "is under the bottom of the screen",
  "and the press did nothing"
 ],
 "steps": [
  {
   "until": "Boolean(tre.activeVillage) && !document.querySelector('.loading-svg') && tre.activeVillage.state().tick > 10",
   "timeout": 600
  },
  {
   "wait": 2
  },
  {
   "tap": {
    "person": "woodcutter"
   },
   "after": 0.3
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "press": true,
   "after": 2
  },
  {
   "until": "Boolean(document.querySelector('.dialogue-layer'))",
   "timeout": 90
  },
  {
   "read": 10
  },
  {
   "wait": 2
  },
  {
   "walk": {
    "thing": "culm:staffs:0"
   },
   "taps": 14,
   "near": 90
  },
  {
   "tap": {
    "thing": "culm:staffs:0"
   },
   "after": 0.5
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "until": "tre.activeVillage.heard().some((x) => /^mentor\\.staffs\\.show/.test(x.key ?? ''))",
   "timeout": 120
  },
  {
   "until": "!tre.activeVillage.state().entities.some((e) => e.script)",
   "timeout": 60
  },
  {
   "wait": 1
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-6).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "1-the-show-counts-to-the-rings-of-the-sample"
  },
  {
   "tap": {
    "thing": "culm:staffs:0"
   },
   "after": 0.5
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "wait": 1.2
  },
  {
   "hold": {
    "until": "(tre.activeVillage.state().entities.find((e) => e.id === 'zone:trial-staffs')?.zone.aim?.at ?? 0) >= 3",
    "timeout": 20
   },
   "shot": "2-the-voice-counts-the-rings"
  },
  {
   "wait": 1.5
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-4).map((x) => [x.key, x.text]))"
  },
  {
   "print": "JSON.stringify(tre.activeVillage.state().entities.find((e) => e.id === 'zone:trial-staffs')?.zone.pieces)"
  },
  {
   "shot": "3-the-cut-is-at-the-mark"
  }
 ]
}
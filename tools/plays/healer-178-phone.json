{
 "about": "#178: grade 4, the leaves of bà lang: the two packs of the model are big and beside the basket; a tap on a pack counts it.",
 "start": "?story=trial-healer",
 "lang": "vi",
 "allow": [
  "is under the bottom of the screen",
  "and the press did nothing"
 ],
 "steps": [
  {
   "until": "Boolean(tre.activeVillage) && !document.querySelector('.loading-svg') && tre.activeVillage.state().tick > 10",
   "timeout": 600
  },
  {
   "wait": 2
  },
  {
   "button": ".hud .icon-btn[aria-label='Trình đơn']",
   "after": 1
  },
  {
   "until": "Boolean(document.querySelector('.modal-layer .menu-list'))",
   "timeout": 30
  },
  {
   "click": "Dành cho bố mẹ",
   "after": 1
  },
  {
   "gate": true
  },
  {
   "click": "Cài đặt",
   "after": 1
  },
  {
   "select": "Lớp của con",
   "value": "4",
   "after": 1
  },
  {
   "button": ".modal-layer .panel-head .icon-btn",
   "after": 1
  },
  {
   "wait": 2
  },
  {
   "tap": {
    "person": "healer"
   },
   "after": 0.3
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "press": true,
   "after": 2
  },
  {
   "until": "Boolean(document.querySelector('.dialogue-layer'))",
   "timeout": 90
  },
  {
   "read": 20
  },
  {
   "wait": 2
  },
  {
   "until": "tre.activeVillage.heard().some((x) => /^mentor\\.first\\.you/.test(x.key ?? ''))",
   "timeout": 120
  },
  {
   "wait": 2
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-3).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "1-the-model-packs-big-beside-the-basket"
  },
  {
   "tap": {
    "place": "leaf-0"
   },
   "after": 2
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-3).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "2-a-tap-on-a-pack-counts-it"
  }
 ]
}
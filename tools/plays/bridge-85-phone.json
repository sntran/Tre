  {
   "shot": "take-a-shorter-plank-the-shorter-planks-glow"
  },
  {
   "until": "!tre.activeVillage.state().entities.some((e) => e.id === 'why:bridge-gap:over')",
   "timeout": 60
  },
  {
   "wait": 2
  },
  {
   "shot": "the-shorter-planks-glow-at-the-pile"
  },
  {
   "until": "!tre.activeVillage.state().entities.some((e) => String(e.id).startsWith('script:'))",
   "timeout": 400
  },
  {
   "tap": {
    "thing": "plank:bridge-gap:5"
   },
   "after": 2
  },
  {
   "press": true,
   "after": 2
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 60
  },
  {
   "wait": 1
  },
  {
   "print": "(tre.activeVillage.state().entities.find((e) => e.item?.held === 'hero')?.item.size ?? null)"
  },
  {
   "check": "(tre.activeVillage.state().entities.find((e) => e.item?.held === 'hero')?.item.size ?? null) === 4"
  },
  {
   "print": "tre.activeVillage.session.action()?.act"
  },
  {
   "press": true,
   "after": 2
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 60
  },
  {
   "wait": 1.5
  },
  {
   "print": "tre.activeVillage.state().entities.find((e) => e.id === 'zone:bridge-gap').zone.items.length"

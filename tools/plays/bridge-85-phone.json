{
 "about": "#85: the new guess lines with the points at the ends of the gap and the rows that glow one by one; no eye at the river; a press with a plank walks to the gap; a plank too long, the line of a shorter plank and the glow of the shorter planks; the guess checked in words.",
 "start": "?story=bridge",
 "lang": "vi",
 "allow": [
  "is under the bottom of the screen"
 ],
 "steps": [
  {
   "until": "Boolean(tre.activeVillage) && !document.querySelector('.loading-svg') && tre.activeVillage.state().tick > 10",
   "timeout": 600
  },
  {
   "until": "Boolean(document.querySelector('.dialogue-layer'))",
   "timeout": 60
  },
  {
   "read": 2
  },
  {
   "wait": 1
  },
  {
   "shot": "the-rows-of-pale-planks"
  },
  {
   "read": 1
  },
  {
   "wait": 0.8
  },
  {
   "shot": "the-fisher-points-at-the-near-end-and-a-row-glows"
  },
  {
   "wait": 2.2
  },
  {
   "shot": "then-at-the-far-end-and-the-next-row-glows"
  },
  {
   "read": 1
  },
  {
   "wait": 2
  },
  {
   "tap": {
    "thing": "zone:bridge-gap",
    "dx": 70
   },
   "after": 1.5
  },
  {
   "print": "tre.activeVillage.session.action()?.act"
  },
  {
   "check": "tre.activeVillage.session.action()?.act !== 'look'"
  },
  {
   "shot": "a-tap-on-the-river-no-eye"
  },
  {
   "tap": {
    "thing": "guess:bridge-gap:3"

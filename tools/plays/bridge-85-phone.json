  {
   "check": "tre.activeVillage.state().entities.find((e) => e.id === 'zone:bridge-gap').zone.items.length === 3"
  },
  {
   "print": "tre.activeVillage.session.action()?.act"
  },
  {
   "check": "tre.activeVillage.session.action()?.act === 'cross'"
  },
  {
   "press": true,
   "after": 2
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 60
  },
  {
   "until": "tre.activeVillage.heard().some((x) => x.key === 'mentor.bridge.guessRight') || tre.activeVillage.heard().some((x) => x.key === 'mentor.bridge.guessOff')",
   "timeout": 300
  },
  {
   "wait": 0.5
  },
  {
   "shot": "the-guess-is-checked-in-words"
  },
  {
   "wait": 3
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-14).map((x) => x.text))"
  }
 ]
}

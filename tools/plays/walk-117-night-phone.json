{
 "about": "#117: a child of K stands beside the teacher and taps the heap and the mat: each tap walks.",
 "start": "?story=trial-scholar&clock=1260",
 "lang": "vi",
 "allow": [
  "is under the bottom of the screen",
  "and the press did nothing"
 ],
 "steps": [
  {
   "until": "Boolean(tre.activeVillage) && !document.querySelector('.loading-svg') && tre.activeVillage.state().tick > 10",
   "timeout": 600
  },
  {
   "wait": 2
  },
  {
   "button": ".hud .icon-btn[aria-label='Trình đơn']",
   "after": 1
  },
  {
   "until": "Boolean(document.querySelector('.modal-layer .menu-list'))",
   "timeout": 30
  },
  {
   "click": "Dành cho bố mẹ",
   "after": 1
  },
  {
   "gate": true
  },
  {
   "click": "Cài đặt",
   "after": 1
  },
  {
   "select": "Lớp của con",
   "value": "0",
   "after": 1
  },
  {
   "button": ".modal-layer .panel-head .icon-btn",
   "after": 1
  },
  {
   "wait": 1
  },
  {
   "tap": {
    "person": "teacher"
   },
   "after": 0.3
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "press": true,
   "after": 2
  },
  {
   "until": "Boolean(document.querySelector('.dialogue-layer'))",
   "timeout": 60
  },
  {
   "read": 20
  },
  {
   "wait": 2
  },
  {
   "until": "tre.activeVillage.heard().some((x) => x.key === 'mentor.first.you')",
   "timeout": 240
  },
  {
   "wait": 1
  },
  {
   "tap": {
    "person": "teacher",
    "dx": 30
   },
   "after": 2
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "shot": "night-beside-the-teacher"
  },
  {
   "print": "JSON.stringify(tre.activeVillage.state().entities.find((e) => e.id === 'hero').position)"
  },
  {
   "tap": {
    "thingExpr": "tre.activeVillage.state().entities.find((e) => e.id === 'zone:rods')?.zone?.items[0] ?? null"
   },
   "after": 1
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "print": "JSON.stringify(tre.activeVillage.state().entities.find((e) => e.id === 'hero').position)"
  },
  {
   "shot": "night-tap-1-on-the-rods-walks"
  },
  {
   "tap": {
    "person": "teacher",
    "dx": 30
   },
   "after": 2
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "print": "JSON.stringify(tre.activeVillage.state().entities.find((e) => e.id === 'hero').position)"
  },
  {
   "tap": {
    "place": "mat"
   },
   "after": 1
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "print": "JSON.stringify(tre.activeVillage.state().entities.find((e) => e.id === 'hero').position)"
  },
  {
   "shot": "night-tap-2-on-the-mat-walks"
  },
  {
   "tap": {
    "person": "teacher",
    "dx": -30
   },
   "after": 2
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "print": "JSON.stringify(tre.activeVillage.state().entities.find((e) => e.id === 'hero').position)"
  },
  {
   "tap": {
    "thingExpr": "tre.activeVillage.state().entities.find((e) => e.id === 'zone:rods')?.zone?.items[0] ?? null"
   },
   "after": 1
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "print": "JSON.stringify(tre.activeVillage.state().entities.find((e) => e.id === 'hero').position)"
  },
  {
   "shot": "night-tap-3-on-the-rods-walks"
  },
  {
   "tap": {
    "person": "teacher",
    "dx": 30
   },
   "after": 2
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  }
 ]
}
{
  "about": "#48: the practice of the woodcutter with taps only. The chalk mark is a band around the stem; a cut that is not equal shows the pieces side by side and the short one breaks; equal sticks go to the wood pile next to the stem.",
  "start": "?practice=chat-tre",
  "lang": "vi",
  "allow": ["is under the bottom of the screen"],
  "steps": [
    {"create": "Nam"},
    {"read": 15},
    {"until": "tre.activeVillage && !tre.activeVillage.state().entities.some((e) => String(e.id).startsWith('script:example'))", "timeout": 600},
    {"read": 15},
    {"wait": 2},
    {"shot": "the-stem"},
    {"tap": {"stem": 3}, "after": 3},
    {"press": true, "after": 2},
    {"check": "tre.activeVillage.state().entities.some((e) => e.look === 'chalk-band')"},
    {"shot": "a-chalk-mark"},
    {"tap": {"person": "woodcutter"}, "after": 3},
    {"press": true, "after": 0.6},
    {"shot": "the-pieces-side-by-side"},
    {"check": "tre.activeVillage.state().entities.filter((e) => String(e.id).startsWith('piece:woodcutter:')).length >= 1"},
    {"wait": 3},
    {"read": 5},
    {"tap": {"stem": 4}, "after": 3},
    {"press": true, "after": 2},
    {"tap": {"person": "woodcutter"}, "after": 3},
    {"press": true, "after": 2},
    {"shot": "equal-sticks"},
    {"tap": {"thing": "sticks:woodcutter"}, "after": 3},
    {"press": true, "after": 2},
    {"tap": {"place": "woodpile"}, "after": 4},
    {"press": true, "after": 3},
    {"wait": 1},
    {"shot": "the-sticks-on-the-pile"},
    {"print": "tre.activeVillage.session.practice.round"},
    {"read": 10},
    {"shot": "at-the-wood-pile"},
    {"check": "tre.activeVillage.session.practice.round >= 1"}
  ]
}

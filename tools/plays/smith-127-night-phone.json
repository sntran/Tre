  },
  {
   "shot": "the-hero-beside-the-anvil"
  },
  {
   "until": "((tre.activeVillage.state().entities.find((e) => e.id === 'iron:smith')?.glow ?? 0) >= 1) || Boolean(tre.activeVillage.state().entities.find((e) => e.id === 'zone:trial-smith')?.zone.done)",
   "timeout": 120
  },
  {
   "press": true,

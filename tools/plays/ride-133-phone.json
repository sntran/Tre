{
 "about": "#133: Nghé: a tap on the calf, the button shows the ride (the calf with a child), a press rides, and the button shows getting off.",
 "start": "?story=nghe",
 "lang": "vi",
 "allow": [
  "is under the bottom of the screen",
  "and the press did nothing"
 ],
 "steps": [
  {
   "until": "Boolean(tre.activeVillage) && !document.querySelector('.loading-svg') && tre.activeVillage.state().tick > 10",
   "timeout": 600
  },
  {
   "wait": 2
  },
  {
   "shot": "the-first-frame"
  },
  {
   "tap": {
    "thing": "friend:nghe"
   },
   "after": 1
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "wait": 1
  },
  {
   "print": "JSON.stringify(tre.activeVillage.session.action())"
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-10).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "the-button-shows-the-ride"
  },
  {
   "press": true,
   "after": 2
  },
  {
   "wait": 1
  },
  {
   "print": "JSON.stringify(tre.activeVillage.session.action())"
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-10).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "riding-the-button-shows-getting-off"
  }
 ]
}
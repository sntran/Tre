{
  "about": "#59: every portrait on a phone. Hero creation (the tiles and the big hero), the name of Nghé, the face in the HUD and in a talk box, and the thing in the hands on the big button (a bunch of herbs). Each frame checks that no portrait on the screen is empty, and a warning of the game fails the play.",
  "start": "",
  "lang": "vi",
  "allow": ["is under the bottom of the screen"],
  "steps": [
    {"wait": 3},
    {"click": "Tiếng Việt"},
    {"click": "Cuộc phiêu lưu mới"},
    {"wait": 2},
    {"click": "Bạn gái"},
    {"click": "Mai"},
    {"click": "Tiếp"},
    {"wait": 4},
    {"check": "Boolean(document.querySelector('.create canvas'))"},
    {"shot": "hero-creation"},
    {"create": "Mai"},
    {"until": "Boolean(document.querySelector('.dialogue-layer, .friend-name-art'))", "timeout": 240},
    {"shot": "the-first-talk"},
    {"read": 30},
    {"click": "đặt tên", "after": 2},
    {"until": "Boolean(document.querySelector('.friend-name-art'))", "timeout": 60},
    {"shot": "the-name-of-nghe"},
    {"click": "Đồng ý", "after": 2},
    {"read": 10},
    {"press": true, "after": 1},
    {"until": "Boolean(document.querySelector('.dialogue-layer .portrait canvas'))", "timeout": 60},
    {"shot": "a-talk-with-a-face"},
    {"read": 20},
    {"wait": 3},
    {"shot": "the-hud"},
    {"goto": "?practice=hai-thuoc", "after": 2},
    {"click": "Mai", "after": 2},
    {"until": "Boolean(tre.activeVillage) && !document.querySelector('.loading-svg') && tre.activeVillage.state().tick > 10", "timeout": 240},
    {"read": 15},
    {"until": "tre.activeVillage && !tre.activeVillage.state().entities.some((e) => String(e.id).startsWith('script:example'))", "timeout": 600},
    {"read": 15},
    {"wait": 2},
    {"tap": {"thing": "herb-ngai:healer:4"}, "after": 0.3},
    {"press": true, "after": 4},
    {"until": "Boolean(document.querySelector('.act-thing-pic'))", "timeout": 60},
    {"shot": "a-herb-in-the-hands"}
  ]
}

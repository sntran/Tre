  {
   "wait": 0.3
  },
  {
   "tap": {
    "stem": 6
   },
   "after": 1,
   "if": "JSON.parse(JSON.stringify(tre.activeVillage.state().entities.find((e) => e.id === 'zone:trial-woodcutter').zone.marks)).includes(6)"
  },
  {
   "wait": 0.3
  },
  {
   "tap": {
    "stem": 7
   },
   "after": 1,
   "if": "JSON.parse(JSON.stringify(tre.activeVillage.state().entities.find((e) => e.id === 'zone:trial-woodcutter').zone.marks)).includes(7)"
  },
  {
   "wait": 0.3
  },
  {
   "tap": {
    "stem": 8
   },
   "after": 1,
   "if": "JSON.parse(JSON.stringify(tre.activeVillage.state().entities.find((e) => e.id === 'zone:trial-woodcutter').zone.marks)).includes(8)"
  },
  {
   "wait": 0.3
  },
  {
   "tap": {
    "stem": 4
   },
   "after": 1
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 180

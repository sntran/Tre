  {
   "wait": 0.5
  },
  {
   "press": true,
   "after": 1.5,
   "if": "!JSON.stringify(tre.activeVillage.state().entities.find((e) => e.id === 'zone:trial-woodcutter').zone.marks).includes('4')"
  },
  {
   "print": "JSON.stringify(tre.activeVillage.state().entities.find((e) => e.id === 'zone:trial-woodcutter').zone.marks)"
  },
  {
   "check": "(() => { window.__p = tre.activeVillage.heard().filter((x) => x.key === 'woodcutter.piece').length; return true; })()"
  },
  {
   "tap": {
    "person": "woodcutter"
   },
   "after": 0.3
  },
  {
   "press": true,
   "after": 0.5
  },
  {
   "until": "tre.activeVillage.heard().some((x) => x.key === 'woodcutter.equal')",
   "timeout": 180

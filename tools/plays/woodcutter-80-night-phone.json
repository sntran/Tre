  {
   "wait": 0.3
  },
  {
   "tap": {
    "stem": 4
   },
   "after": 1,
   "if": "JSON.parse(JSON.stringify(tre.activeVillage.state().entities.find((e) => e.id === 'zone:trial-woodcutter').zone.marks)).includes(4)"
  },
  {
   "wait": 0.3
  },
  {
   "tap": {
    "stem": 5
   },
   "after": 1,
   "if": "JSON.parse(JSON.stringify(tre.activeVillage.state().entities.find((e) => e.id === 'zone:trial-woodcutter').zone.marks)).includes(5)"

  {
   "wait": 0.3
  },
  {
   "print": "tre.activeVillage.heard().filter((x) => x.key === 'woodcutter.piece').length - window.__p"
  },
  {
   "shot": "night-a-right-cut-is-counted"
  },
  {
   "until": "Boolean(tre.activeVillage.state().entities.find((e) => e.id === 'sticks:woodcutter'))",
   "timeout": 60
  },
  {
   "wait": 1
  },
  {
   "shot": "night-the-sticks-come"
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().map((x) => x.key))"
  }
 ]

{
 "about": "#139: the hopscotch at grade 3: the court starts above one; the first square glows and has its number in chalk, and the child says which square it is. At 21:00.",
 "start": "?story=trick-hopscotch&clock=1260",
 "lang": "vi",
 "allow": [
  "is under the bottom of the screen",
  "and the press did nothing"
 ],
 "steps": [
  {
   "until": "Boolean(tre.activeVillage) && !document.querySelector('.loading-svg') && tre.activeVillage.state().tick > 10",
   "timeout": 600
  },
  {
   "wait": 2
  },
  {
   "button": ".hud .icon-btn[aria-label='Trình đơn']",
   "after": 1
  },
  {
   "until": "Boolean(document.querySelector('.modal-layer .menu-list'))",
   "timeout": 30
  },
  {
   "click": "Dành cho bố mẹ",
   "after": 1
  },
  {
   "gate": true
  },
  {
   "click": "Cài đặt",
   "after": 1
  },
  {
   "select": "Lớp của con",
   "value": "3",
   "after": 1
  },
  {
   "button": ".modal-layer .panel-head .icon-btn",
   "after": 1
  },
  {
   "wait": 1
  },
  {
   "tap": {
    "person": "loco-child"
   },
   "after": 2
  },
  {
   "press": true,
   "after": 1
  },
  {
   "print": "JSON.stringify(tre.activeVillage.session.folk()?.court?.slice?.(0, 3) ?? tre.activeVillage.session.folk()?.court)"
  },
  {
   "until": "tre.activeVillage.heard().some((x) => x.key === 'loco.first')",
   "timeout": 60
  },
  {
   "wait": 0.3
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-10).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "the-first-square-and-its-number"
  },
  {
   "wait": 3
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-10).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "the-court"
  }
 ]
}
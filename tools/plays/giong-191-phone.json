{
 "about": "#191: grade 3, the raid of the general: the line names Gióng when Gióng on his horse is on the screen.",
 "start": "?story=raid-boss",
 "lang": "vi",
 "allow": [
  "is under the bottom of the screen",
  "and the press did nothing"
 ],
 "steps": [
  {
   "until": "Boolean(tre.activeVillage) && !document.querySelector('.loading-svg') && tre.activeVillage.state().tick > 10",
   "timeout": 600
  },
  {
   "wait": 2
  },
  {
   "button": ".hud .icon-btn[aria-label='Trình đơn']",
   "after": 1
  },
  {
   "until": "Boolean(document.querySelector('.modal-layer .menu-list'))",
   "timeout": 30
  },
  {
   "click": "Dành cho bố mẹ",
   "after": 1
  },
  {
   "gate": true
  },
  {
   "click": "Cài đặt",
   "after": 1
  },
  {
   "select": "Lớp của con",
   "value": "3",
   "after": 1
  },
  {
   "button": ".modal-layer .panel-head .icon-btn",
   "after": 1
  },
  {
   "wait": 2
  },
  {
   "walk": {
    "person": "boss"
   },
   "taps": 14
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "tap": {
    "person": "boss"
   },
   "after": 0.3
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "press": true,
   "after": 2
  },
  {
   "until": "Boolean(document.querySelector('.dialogue-layer, .say-layer'))",
   "timeout": 30
  },
  {
   "read": 4
  },
  {
   "until": "tre.activeVillage.heard().some((x) => x.key === 'giong.seen.horse')",
   "timeout": 60
  },
  {
   "wait": 0.3
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-4).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "1-gióng-on-his-horse-on-the-screen-with-his-name"
  }
 ]
}
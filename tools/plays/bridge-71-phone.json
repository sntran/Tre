{
 "about": "#71: the bridge after the trial of the fisher: the planks for the guess glow with their words, a tap chooses a plank of five, the ruler marks of the gap, a press at the pile takes five again, a plank of four is too long and its part over the far bank glows, and the count goes unit by unit.",
 "start": "?story=bridge",
 "lang": "vi",
 "allow": [
  "is under the bottom of the screen"
 ],
 "steps": [
  {
   "until": "Boolean(tre.activeVillage) && !document.querySelector('.loading-svg') && tre.activeVillage.state().tick > 10",
   "timeout": 600
  },
  {
   "until": "Boolean(document.querySelector('.dialogue-layer'))",
   "timeout": 60
  },
  {
   "read": 2
  },
  {
   "wait": 0.5
  },
  {
   "shot": "the-planks-for-the-guess-glow"
  },
  {
   "read": 4
  },
  {
   "wait": 2
  },
  {
   "tap": {
    "thing": "guess:bridge-gap:3"
   },
   "after": 2,
   "if": "tre.activeVillage.state().entities.some((e) => e.id === 'guess:bridge-gap:3' && !e.hidden)"
  },
  {
   "press": true,
   "after": 3
  },
  {
   "read": 6
  },
  {
   "tap": {
    "cell": [
     9404,
     6308
    ]
   },
   "after": 3
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 60
  },
  {
   "tap": {
    "thing": "plank:bridge-gap:7"
   },
   "after": 3
  },
  {
   "press": true,
   "after": 2
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 60
  },
  {
   "wait": 1
  },
  {
   "print": "(tre.activeVillage.state().entities.find((e) => e.item?.held === 'hero')?.item.size ?? null)"
  },
  {
   "check": "(tre.activeVillage.state().entities.find((e) => e.item?.held === 'hero')?.item.size ?? null) === 5"
  },
  {
   "tap": {
    "thing": "zone:bridge-gap"
   },
   "after": 3
  },
  {
   "press": true,

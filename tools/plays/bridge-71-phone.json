  {
   "wait": 0.2
  },
  {
   "shot": "the-count-goes-unit-by-unit"
  },
  {
   "until": "!tre.activeVillage.state().entities.some((e) => e.id === 'why:bridge-gap:over')",
   "timeout": 60
  },
  {
   "wait": 2
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-20).map((x) => x.text))"
  }
 ]
}

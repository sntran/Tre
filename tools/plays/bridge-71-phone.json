  {
   "tap": {
    "thing": "zone:bridge-gap"
   },
   "after": 3
  },
  {
   "press": true,
   "after": 2
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 60
  },
  {
   "wait": 1
  },
  {
   "print": "tre.activeVillage.state().entities.find((e) => e.id === 'zone:bridge-gap').zone.items.length"
  },
  {
   "check": "tre.activeVillage.state().entities.find((e) => e.id === 'zone:bridge-gap').zone.items.length === 2"
  },
  {
   "tap": {
    "cell": [
     9404,
     6308
    ]
   },
   "after": 3
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 60
  },
  {
   "tap": {
    "thing": "plank:bridge-gap:3"
   },
   "after": 3
  },
  {
   "press": true,
   "after": 2
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 60
  },
  {
   "wait": 1
  },
  {
   "print": "(tre.activeVillage.state().entities.find((e) => e.item?.held === 'hero')?.item.size ?? null)"
  },
  {
   "tap": {
    "thing": "zone:bridge-gap"
   },
   "after": 3
  },
  {
   "press": true,
   "after": 0.3
  },
  {
   "until": "tre.activeVillage.state().entities.some((e) => e.id === 'why:bridge-gap:over')",
   "timeout": 30
  },
  {
   "wait": 0.5
  },
  {
   "shot": "too-long-the-part-over-the-bank-glows"
  },
  {
   "until": "tre.activeVillage.heard().slice(-1)[0]?.key === 'num.4'",
   "timeout": 60

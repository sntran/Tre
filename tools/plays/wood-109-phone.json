{
 "about": "#109: the woodcutter: before the first mark the chalk is a see-through band, a tap on the stem and a press make the first mark, and the woodcutter says what the chalk is.",
 "start": "?story=trial-woodcutter",
 "lang": "vi",
 "allow": [
  "is under the bottom of the screen",
  "and the press did nothing"
 ],
 "steps": [
  {
   "until": "Boolean(tre.activeVillage) && !document.querySelector('.loading-svg') && tre.activeVillage.state().tick > 10",
   "timeout": 600
  },
  {
   "wait": 2
  },
  {
   "tap": {
    "person": "woodcutter"
   },
   "after": 0.3
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "press": true,
   "after": 2
  },
  {
   "until": "Boolean(document.querySelector('.dialogue-layer'))",
   "timeout": 60
  },
  {
   "read": 15
  },
  {
   "wait": 2
  },
  {
   "until": "tre.activeVillage.heard().some((x) => x.key === 'mentor.woodcutter.first')",
   "timeout": 120
  },
  {
   "wait": 2
  },
  {
   "tap": {
    "stem": 4
   },
   "after": 1
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "wait": 1
  },
  {
   "shot": "the-chalk-before-the-first-mark-is-see-through"
  },
  {
   "press": true,
   "after": 2
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-12).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "the-first-mark-and-the-line-of-the-chalk"
  }
 ]
}
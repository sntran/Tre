{
 "about": "#125: the healer at grade 4: a talk that starts at the well walks to her beds; the model is hers (a tap on it says its count); one deal of the model; the leaves are big enough.",
 "start": "?story=trial-healer",
 "lang": "vi",
 "allow": [
  "is under the bottom of the screen",
  "and the press did nothing"
 ],
 "steps": [
  {
   "until": "Boolean(tre.activeVillage) && !document.querySelector('.loading-svg') && tre.activeVillage.state().tick > 10",
   "timeout": 600
  },
  {
   "wait": 2
  },
  {
   "button": ".hud .icon-btn[aria-label='Trình đơn']",
   "after": 1
  },
  {
   "until": "Boolean(document.querySelector('.modal-layer .menu-list'))",
   "timeout": 30
  },
  {
   "click": "Dành cho bố mẹ",
   "after": 1
  },
  {
   "gate": true
  },
  {
   "click": "Cài đặt",
   "after": 1
  },
  {
   "select": "Lớp của con",
   "value": "4",
   "after": 1
  },
  {
   "button": ".modal-layer .panel-head .icon-btn",
   "after": 1
  },
  {
   "wait": 1
  },
  {
   "tap": {
    "person": "healer"
   },
   "after": 0.3
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "press": true,
   "after": 2
  },
  {
   "until": "Boolean(document.querySelector('.dialogue-layer'))",
   "timeout": 90
  },
  {
   "read": 3
  },
  {
   "wait": 2
  },
  {
   "wait": 3
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-10).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "the-talk-walks-to-the-beds"
  },
  {
   "read": 20
  },
  {
   "wait": 2
  },
  {
   "until": "tre.activeVillage.heard().some((x) => x.key === 'mentor.first.you')",
   "timeout": 120
  },
  {
   "wait": 3
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-10).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "the-model-on-its-leaves"
  },
  {
   "tap": {
    "place": "leaf-0"
   },
   "after": 1
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "wait": 3
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-10).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "a-tap-on-the-model-says-its-count"
  },
  {
   "tap": {
    "thing": "zone:bed-ngai"
   },
   "after": 1
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "press": true,
   "after": 1.6
  },
  {
   "wait": 1
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-10).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "a-bunch-in-the-hands-the-basket-glows"
  }
 ]
}
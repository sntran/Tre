{
  "about": "#45: the practice of Xóm Ruộng from a link on a new device. The short creation has the two language buttons and a help for the name; the visit starts at seven in the morning; the head of the hamlet names each station while its star pulses; no market line; the bar of the quest says what to do; the light holds.",
  "start": "?practice=xom-ruong",
  "lang": "vi",
  "allow": ["the button Tiếp is under the bottom of the screen"],
  "steps": [
    {"wait": 4},
    {"shot": "short-creation"},
    {"click": "Tiếp"},
    {"wait": 1},
    {"shot": "name-help"},
    {"check": "!document.querySelector('.name-need').hidden"},
    {"click": "Bạn gái"},
    {"click": "Mai"},
    {"create": ""},
    {"print": "tre.activeVillage.session.state.clock"},
    {"check": "Math.floor(tre.activeVillage.session.state.clock.minutes % 1440 / 60) === 7"},
    {"wait": 1.5},
    {"shot": "greeting-first-station"},
    {"wait": 3.2},
    {"shot": "greeting-second-station"},
    {"wait": 3.2},
    {"wait": 3.2},
    {"shot": "greeting-fourth-station"},
    {"read": 10},
    {"wait": 4},
    {"shot": "the-goal-of-the-hamlet"},
    {"check": "document.body.textContent.includes('Giúp người ở Xóm Ruộng')"},
    {"restless": 20, "seed": 7},
    {"read": 10},
    {"tap": {"star": true}},
    {"wait": 2},
    {"restless": 20, "seed": 8},
    {"read": 10},
    {"shot": "after-restless-play"},
    {"print": "tre.activeVillage.session.state.clock"},
    {"check": "!document.body.textContent.includes('chợ')"}
  ]
}

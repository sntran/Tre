{
 "about": "#147: grade 1 at night, the quench of the smith: the hero in front of the iron draws pale and see-through, with a dotted ink line.",
 "start": "?story=trial-smith&clock=1260",
 "lang": "vi",
 "allow": [
  "is under the bottom of the screen",
  "and the press did nothing"
 ],
 "steps": [
  {
   "until": "Boolean(tre.activeVillage) && !document.querySelector('.loading-svg') && tre.activeVillage.state().tick > 10",
   "timeout": 600
  },
  {
   "wait": 2
  },
  {
   "button": ".hud .icon-btn[aria-label='Trình đơn']",
   "after": 1
  },
  {
   "until": "Boolean(document.querySelector('.modal-layer .menu-list'))",
   "timeout": 30
  },
  {
   "click": "Dành cho bố mẹ",
   "after": 1
  },
  {
   "gate": true
  },
  {
   "click": "Cài đặt",
   "after": 1
  },
  {
   "select": "Lớp của con",
   "value": "1",
   "after": 1
  },
  {
   "button": ".modal-layer .panel-head .icon-btn",
   "after": 1
  },
  {
   "wait": 2
  },
  {
   "walk": {
    "person": "smith"
   },
   "taps": 10
  },
  {
   "tap": {
    "person": "smith"
   },
   "after": 0.3
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "press": true,
   "after": 2
  },
  {
   "until": "Boolean(document.querySelector('.dialogue-layer'))",
   "timeout": 60
  },
  {
   "read": 12
  },
  {
   "wait": 1
  },
  {
   "until": "tre.activeVillage.heard().some((x) => /smith\\.quench/.test(x.key ?? ''))",
   "timeout": 120
  },
  {
   "wait": 1
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-3).map((x) => [x.key, x.text]))"
  },
  {
   "print": "JSON.stringify([...tre.activeVillage.seeThrough()])"
  },
  {
   "shot": "3-the-iron-through-the-hero"
  },
  {
   "wait": 2
  },
  {
   "print": "JSON.stringify([...tre.activeVillage.seeThrough()])"
  },
  {
   "shot": "4-the-iron-red"
  }
 ]
}
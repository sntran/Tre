  },
  {
   "shot": "1-the-first-talk-in-short-lines"
  },
  {
   "read": 10
  },
  {
   "wait": 2
  },
  {
   "walk": {
    "thing": "culm:staffs:0"
   },
   "taps": 14,
   "near": 90
  },
  {
   "tap": {
    "thing": "culm:staffs:0"
   },
   "after": 0.5
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "until": "tre.activeVillage.heard().some((x) => /^mentor\\.first\\.you/.test(x.key ?? ''))",
   "timeout": 120
  },
  {
   "until": "!tre.activeVillage.state().entities.some((e) => e.script)",
   "timeout": 60
  },
  {
   "wait": 1
  },
  {
   "tap": {
    "thing": "culm:staffs:0"
   },
   "after": 0.5
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240

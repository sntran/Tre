{
 "about": "#123: the woodcutter at grade 5 with a stem of 24: the stem has its figure and is whole in the frame; a mark at one third.",
 "start": "?story=woodcutter-stem-24",
 "lang": "vi",
 "allow": [
  "is under the bottom of the screen",
  "and the press did nothing"
 ],
 "steps": [
  {
   "until": "Boolean(tre.activeVillage) && !document.querySelector('.loading-svg') && tre.activeVillage.state().tick > 10",
   "timeout": 600
  },
  {
   "wait": 2
  },
  {
   "tap": {
    "person": "woodcutter"
   },
   "after": 0.3
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "press": true,
   "after": 2
  },
  {
   "until": "Boolean(document.querySelector('.dialogue-layer'))",
   "timeout": 90
  },
  {
   "read": 15
  },
  {
   "wait": 2
  },
  {
   "until": "tre.activeVillage.heard().some((x) => x.key === 'mentor.woodcutter.first')",
   "timeout": 60
  },
  {
   "wait": 3
  },
  {
   "print": "JSON.stringify({look: tre.activeVillage.state().entities.find((e) => e.id === 'stem:woodcutter')?.look, size: tre.activeVillage.state().entities.find((e) => e.id === 'stem:woodcutter')?.item.size})"
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-10).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "the-whole-stem"
  },
  {
   "tap": {
    "stem": 8
   },
   "after": 1
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "press": true,
   "after": 1.5
  },
  {
   "press": true,
   "after": 1.5
  },
  {
   "wait": 1
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-10).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "a-mark-at-one-third"
  }
 ]
}
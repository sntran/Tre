{
 "about": "#118: the woodcutter at grade 1: a mark near the end with a tap and presses, the cut, the numbers of the pieces, the glow of the long piece, and the grey chalk of the last try.",
 "start": "?story=trial-woodcutter",
 "lang": "vi",
 "allow": [
  "is under the bottom of the screen",
  "and the press did nothing"
 ],
 "steps": [
  {
   "until": "Boolean(tre.activeVillage) && !document.querySelector('.loading-svg') && tre.activeVillage.state().tick > 10",
   "timeout": 600
  },
  {
   "wait": 2
  },
  {
   "button": ".hud .icon-btn[aria-label='Trình đơn']",
   "after": 1
  },
  {
   "until": "Boolean(document.querySelector('.modal-layer .menu-list'))",
   "timeout": 30
  },
  {
   "click": "Dành cho bố mẹ",
   "after": 1
  },
  {
   "gate": true
  },
  {
   "click": "Cài đặt",
   "after": 1
  },
  {
   "select": "Lớp của con",
   "value": "1",
   "after": 1
  },
  {
   "button": ".modal-layer .panel-head .icon-btn",
   "after": 1
  },
  {
   "wait": 1
  },
  {
   "tap": {
    "person": "woodcutter"
   },
   "after": 0.3
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "press": true,
   "after": 2
  },
  {
   "until": "Boolean(document.querySelector('.dialogue-layer'))",
   "timeout": 60
  },
  {
   "read": 20
  },
  {
   "wait": 2
  },
  {
   "until": "tre.activeVillage.heard().some((x) => x.key === 'mentor.woodcutter.first')",
   "timeout": 240
  },
  {
   "wait": 1
  },
  {
   "shot": "grade-1-the-stem"
  },
  {
   "tap": {
    "stem": 2
   },
   "after": 1
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "press": true,
   "after": 1.6
  },
  {
   "press": true,
   "after": 1.6
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-10).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "a-mark-and-the-button"
  },
  {
   "tap": {
    "person": "woodcutter"
   },
   "after": 1
  },
  {
   "until": "!tre.activeVillage.state().entities.find((e) => e.id === 'hero')?.route",
   "timeout": 240
  },
  {
   "press": true,
   "after": 2
  },
  {
   "until": "tre.activeVillage.heard().some((x) => /^woodcutter\\.(longer|pieceN|piece|equal)$/.test(x.key))",
   "timeout": 90
  },
  {
   "wait": 4
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-10).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "the-pieces-and-their-numbers"
  },
  {
   "until": "tre.activeVillage.heard().some((x) => /^woodcutter\\.(move|rest|equal)/.test(x.key)) || tre.activeVillage.heard().some((x) => x.key === 'trial.done')",
   "timeout": 120
  },
  {
   "wait": 2
  },
  {
   "print": "JSON.stringify(tre.activeVillage.heard().slice(-10).map((x) => [x.key, x.text]))"
  },
  {
   "shot": "the-grey-chalk-and-the-way-to-move-it"
  }
 ]
}
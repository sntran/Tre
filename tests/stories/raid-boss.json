{
  "name": "raid-boss",
  "about": {
    "vi": "Trận ở chân núi Trâu Sơn: lính trước, rồi tướng Ân giơ gươm, gậy sắt gãy, và Gióng nhổ tre đánh đuổi giặc.",
    "en": "The raid at the foot of Trâu Sơn: soldiers first, then the Ân general lifts his sword, the iron staff breaks, and Gióng pulls up bamboo to drive the enemy away."
  },
  "profile": {"name": "An", "grade": 3, "lang": "vi", "seed": 9, "flags": {"intro.seen": true, "giong.grown": true, "soldier1.won": true, "soldier2.won": true}, "items": {"coin": 5}},
  "map": "trau-son",
  "clock": 600,
  "place": [34, 15],
  "steps": [
    {"tap": {"entity": "encounter:boss"}},
    {"until": {"event": "open", "with": {"screen": "say"}, "timeout": 30}},
    {"expect": [{"text": {"shown": "raid.boss.intro"}}]},
    {"read": true},
    {"wait": 0.5},
    {"expect": [{"raid": {"on": true, "phase": "soldiers"}}, {"entity": "companion:raid", "near": "hero", "within": 2}]},
    { "repeat": 14, "steps": [
      {"shoot": {"at": "first", "kind": "soldier", "lead": 0.8, "wait": true}},
      {"wait": 1.4}
    ] },
    {"expect": [{"raid": {"phase": "general"}}, {"event": "phase", "with": {"phase": "general"}}]},
    {"until": {"event": "sword", "timeout": 80}},
    {"expect": [{"entity": "raider:4", "act": "sword"}]},
    {"until": {"event": "hurt", "timeout": 5}},
    {"expect": [{"event": "horns"}]},
    { "repeat": 8, "steps": [
      {"shoot": {"at": "first", "lead": 0.8, "wait": true}},
      {"wait": 1.4}
    ] },
    {"expect": [{"event": "stunned"}, {"screen": "dialogue"}, {"text": {"shown": "dlg.staff.breaks.n1"}}, {"raid": {"phase": "staff"}}]},
    {"read": true},
    {"tap": {"raid": "bamboo"}},
    {"until": {"event": "open", "with": {"screen": "dialogue"}, "timeout": 10}},
    {"expect": [{"event": "strike"}, {"text": {"shown": "dlg.bamboo.found.n1"}}, {"flag": "era1.boss.won"}]},
    {"read": true},
    {"expect": [{"text": {"shown": "raid.boss.note"}}, {"text": {"shown": "history.giong.festival"}}, {"text": {"shown": "dlg.giong.north.n1"}}]},
    {"wait": 4},
    {"expect": [{"raid": {"on": false}}, {"count": {"entities": "raider", "max": 0}}]}
  ]
}

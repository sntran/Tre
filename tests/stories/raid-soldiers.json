{
  "name": "raid-soldiers",
  "about": {
    "vi": "Lính Ân từ cánh đồng tới ngã tư: người làng ra đứng ở lá cờ rơm, một cái bẫy ở cột thứ ba bác thợ rèn nói, Nghé lao vào một lần, rồi bắn ná cho tới khi chúng lui.",
    "en": "Ân soldiers come from the field to the crossroads: a villager at a straw flag, a trap at the third post that the smith names, Nghé charges once, and the slingshot turns them back."
  },
  "profile": { "name": "An", "grade": 2, "lang": "vi", "seed": 5, "flags": { "intro.seen": true, "giong.grown": true, "raid.tool.sling": true, "raid.tool.gate": true }, "items": { "coin": 5 } },
  "map": "trau-son",
  "clock": 600,
  "place": [25, 26],
  "steps": [
    { "tap": { "entity": "encounter:soldier1" } },
    { "until": { "event": "open", "with": { "screen": "say" }, "timeout": 20 } },
    { "read": true },
    { "expect": [{ "text": { "shown": "raid.soldier.intro" } }, { "text": { "shown": "raid.tool.traps" } }, { "text": { "shown": "raid.tool.helpers" } }, { "text": { "shown": "raid.tool.nghe" } }, { "text": { "shown": "raid.trap.ask" } }] },
    { "wait": 0.5 },
    { "expect": [{ "raid": { "on": true } }, { "hero": { "cell": [25, 30], "within": 1 } }, { "count": { "entities": "spot-mark", "min": 2 } }, { "count": { "entities": "source", "max": 0 } }] },
    { "tap": { "raid": "spot:1" } },
    { "tap": { "item": "trap" } },
    { "until": { "event": "pick", "timeout": 15 } },
    { "tap": { "cell": [25, 22.5] } },
    { "until": { "event": "put", "with": { "zone": "raid-road" }, "timeout": 15 } },
    { "expect": [{ "event": "skill", "with": { "skill": "math.count.120", "task": "raid-soldier1", "parts": [15] } }] },
    { "tap": { "cell": [25, 30] } },
    { "until": { "event": "snap", "timeout": 40 } },
    { "do": { "type": "pet" } },
    { "until": { "event": "butt", "timeout": 10 } },
    { "expect": [{ "event": "charge" }, { "event": "hit", "with": { "by": "nghe" } }] },
    { "until": { "event": "pause", "timeout": 40 } },
    { "repeat": 10, "steps": [
      { "shoot": { "at": "first", "lead": 1.2, "wait": true } },
      { "wait": 1.4 }
    ] },
    { "until": { "event": "open", "with": { "screen": "say" }, "timeout": 60 } },
    { "expect": [{ "event": "end", "with": { "won": true } }, { "flag": "soldier1.won" }, { "text": { "shown": "raid.soldier.note" } }] },
    { "read": true },
    { "wait": 3 },
    { "expect": [{ "raid": { "on": false } }, { "item": "iron", "count": ">= 1" }] }
  ]
}

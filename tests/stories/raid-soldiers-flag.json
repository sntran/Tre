{
  "name": "raid-soldiers-flag",
  "about": {
    "vi": "Lớp một, trận lính Ân thứ hai: cháu đã dùng bẫy ở trận trước, nên thứ mới của trận này là lá cờ rơm, với câu của nó. Không có chum nước, lò than, hay Nghé. Giặc chỉ đến khi cháu gọi một người làng ra lá cờ.",
    "en": "Grade 1, the second raid of the Ân soldiers: the child used the traps in the raid before, so the new thing of this raid is the straw flag, with its line. No jar of water, no brazier, and no Nghé. The enemies come only when the child calls a villager to the flag."
  },
  "profile": { "name": "Su", "grade": 1, "lang": "vi", "seed": 5, "flags": { "intro.seen": true, "giong.grown": true, "soldier1.won": true, "raid.tool.sling": true, "raid.tool.gate": true, "raid.tool.traps": true, "raid.used.sling": 3, "raid.used.traps": 1 }, "items": { "rice": 5 } },
  "clock": 420,
  "at": ["trau-son", 89, 38],
  "steps": [
    { "press": { "entity": "encounter:soldier2" } },
    { "until": { "event": "open", "with": { "screen": "say" }, "timeout": 20 } },
    { "read": true },
    { "expect": [{ "text": { "shown": "raid.soldier.intro" } }, { "text": { "shown": "raid.tool.helpers" } }, { "event": "open", "with": { "textKey": "raid.tool.nghe" }, "not": true }, { "event": "open", "with": { "textKey": "raid.tool.water" }, "not": true }, { "event": "open", "with": { "textKey": "raid.tool.fire" }, "not": true }] },
    { "wait": 0.5 },
    { "expect": [{ "raid": { "on": true } }, { "count": { "entities": "spot-mark", "min": 2 } }, { "count": { "entities": "source", "max": 0 } }, { "count": { "entities": "raider", "max": 0 } }] },
    { "wait": 5 },
    { "expect": [{ "count": { "entities": "raider", "max": 0 } }] },
    { "tap": { "raid": "spot:1" } },
    { "until": { "event": "summon", "timeout": 10 } },
    { "until": { "event": "pause", "timeout": 60 } },
    { "repeat": 12, "steps": [{ "shoot": { "at": "first", "lead": 1.2, "wait": true } }, { "wait": 1.4 }] },
    { "until": { "event": "open", "with": { "screen": "say" }, "timeout": 60 } },
    { "expect": [{ "event": "end", "with": { "won": true } }, { "flag": "soldier2.won" }, { "flag": "raid.tool.helpers" }, { "flag": "raid.tool.water", "is": false }] }
  ]
}

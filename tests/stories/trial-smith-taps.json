{
  "name": "trial-smith-taps",
  "about": {
    "vi": "Trong lúc làm việc của bác thợ rèn, mỗi lần chạm vào bác là một lần xin giúp: lần nào bác cũng giúp, không bao giờ chỉ gật đầu, và không mở lại lời mở đầu.",
    "en": "During the work of the smith, each tap on him asks for help: he helps each time (a wave never gets only a nod, #64), and the taps never open the start talk again."
  },
  "profile": { "name": "An", "grade": 1, "lang": "vi", "seed": 7, "flags": { "intro.seen": true, "prologue.started": true } },
  "clock": 540,
  "at": ["phu-dong", 53, 43],
  "steps": [
    { "press": { "entity": "npc:smith" } },
    { "until": { "event": "open", "with": { "screen": "dialogue" }, "timeout": 20 } },
    { "read": true },
    { "expect": [{ "text": { "shown": "dlg.smith.trial.n1" } }] },
    { "repeat": 2, "steps": [
      { "press": { "entity": "npc:smith" } },
      { "wait": 1.5 },
      { "expect": [{ "screen": null }, { "event": "open", "with": { "screen": "dialogue" }, "not": true }, { "event": "mentor", "with": { "key": "trial-smith" } }, { "event": "open", "with": { "screen": "callout" } }] }
    ] },
    { "repeat": 8, "steps": [
      { "press": { "entity": "npc:smith" } },
      { "wait": 1.5 },
      { "expect": [{ "screen": null }, { "event": "open", "with": { "screen": "dialogue" }, "not": true }, { "event": "nod", "with": { "id": "npc:smith" }, "not": true }] }
    ] },
    { "until": { "event": "mentor", "with": { "key": "trial-smith" }, "timeout": 30 } }
  ]
}

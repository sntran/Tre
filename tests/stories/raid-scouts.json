{
  "name": "raid-scouts",
  "about": {
    "vi": "Lính trinh sát ở cổng làng: một cái bẫy trên đường, một người làng ra đứng canh, cài then cổng trước khi đuốc bay tới, và bắn ná cho tới khi chúng lui.",
    "en": "The scouts at the gate: a trap on the road, a villager at a spot, the gate bar before a torch lands, and the slingshot until they turn back."
  },
  "profile": { "name": "An", "grade": 2, "lang": "vi", "seed": 3, "flags": { "intro.seen": true, "giong.spoke": true }, "items": { "coin": 5 } },
  "map": "phu-dong",
  "clock": 540,
  "place": [61, 29],
  "steps": [
    { "tap": { "entity": "encounter:scouts" } },
    { "until": { "event": "open", "with": { "screen": "say" }, "timeout": 20 } },
    { "expect": [{ "text": { "shown": "raid.scouts.intro" } }] },
    { "read": true },
    { "wait": 0.5 },
    { "expect": [{ "raid": { "on": true, "enemies": ">= 1" } }, { "hero": { "cell": [63, 29], "within": 1 } }, { "entity": "encounter:scouts", "hidden": true }, { "count": { "entities": "post", "min": 4 } }] },
    { "tap": { "raid": "spot:1" } },
    { "tap": { "item": "trap" } },
    { "until": { "event": "pick", "timeout": 15 } },
    { "tap": { "cell": [73, 29] } },
    { "until": { "event": "put", "with": { "zone": "raid-road" }, "timeout": 15 } },
    { "until": { "event": "snap", "timeout": 30 } },
    { "expect": [{ "event": "skill", "with": { "skill": "math.count.120", "task": "raid-scouts" } }, { "event": "spot" }] },
    { "tap": { "cell": [63, 29] } },
    { "wait": 3 },
    { "shoot": { "at": "first" } },
    { "until": { "event": "land", "timeout": 5 } },
    { "expect": [{ "event": "hit" }, { "event": "skill", "with": { "skill": "math.count.120", "solved": true, "first": true } }] },
    { "until": { "event": "light", "timeout": 40 } },
    { "wait": 0.5 },
    { "tap": { "raid": "gate" } },
    { "until": { "event": "stop", "timeout": 5 } },
    { "expect": [{ "event": "bar" }, { "event": "skill", "with": { "task": "raid-scouts", "solved": true, "efficient": true } }, { "raid": { "losses": 0 } }] },
    { "do": { "type": "pet" } },
    { "until": { "event": "butt", "timeout": 10 } },
    { "repeat": 7, "steps": [
      { "shoot": { "at": "first", "lead": 0.8, "wait": true } },
      { "wait": 1.2 }
    ] },
    { "until": { "event": "open", "with": { "screen": "say" }, "timeout": 40 } },
    { "expect": [{ "event": "end", "with": { "won": true } }, { "flag": "scouts.won" }, { "event": "gift", "with": { "give": { "iron": 2, "coin": 2 } } }, { "text": { "shown": "battle.scouts.note" } }] },
    { "read": true },
    { "expect": [{ "text": { "shown": "dlg.scouts.won.n1" } }, { "item": "iron", "count": ">= 2" }] },
    { "wait": 3 },
    { "expect": [{ "raid": { "on": false } }, { "count": { "entities": "raider", "max": 0 } }] }
  ]
}

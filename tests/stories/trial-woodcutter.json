{
  "name": "trial-woodcutter",
  "about": {
    "vi": "Thử thách của anh tiều phu: vạch phấn chia cây tre thành hai khúc bằng nhau; chia lệch thì khúc ngắn gãy, chia đều thì mang bó tre ra đống gỗ cạnh cầu.",
    "en": "The trial of the woodcutter: chalk marks for two equal sticks; marks off the middle and the short stick breaks, equal sticks go to the wood pile by the bridge."
  },
  "profile": { "name": "An", "grade": 1, "lang": "vi", "seed": 7, "flags": { "intro.seen": true, "prologue.started": true } },
  "map": "phu-dong",
  "clock": 540,
  "place": [51, 8.5],
  "steps": [
    { "tap": { "entity": "npc:woodcutter" } },
    { "until": { "event": "open", "with": { "screen": "dialogue" }, "timeout": 20 } },
    { "read": true },
    { "expect": [{ "text": { "shown": "dlg.woodcutter.trial.n1" } }, { "entity": "stem:woodcutter", "look": "stem-8" }] },
    { "tap": { "stem": 3 } },
    { "until": { "event": "mark", "timeout": 10 } },
    { "tap": { "entity": "npc:woodcutter" } },
    { "until": { "event": "snap", "timeout": 10 } },
    { "expect": [{ "event": "skill", "with": { "skill": "math.add.20", "solved": false, "parts": [3, 5] } }] },
    { "wait": 2 },
    { "tap": { "stem": 4 } },
    { "until": { "event": "mark", "timeout": 10 } },
    { "tap": { "entity": "npc:woodcutter" } },
    { "until": { "event": "chop", "timeout": 10 } },
    { "expect": [{ "event": "skill", "with": { "solved": true, "parts": [4, 4] } }, { "count": { "entities": "sticks-2", "min": 1 } }] },
    { "tap": { "item": "sticks" } },
    { "until": { "event": "pick", "timeout": 10 } },
    { "tap": { "zone": "woodpile" } },
    { "until": { "event": "trial", "timeout": 120 } },
    { "until": { "event": "open", "with": { "screen": "dialogue" }, "timeout": 5 } },
    { "expect": [{ "flag": "trial.woodcutter.done" }, { "text": { "shown": "dlg.woodcutter.trial.done.n1" } }] },
    { "read": true }
  ]
}

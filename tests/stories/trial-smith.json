{
  "name": "trial-smith",
  "about": {
    "vi": "Thử thách của bác thợ rèn: lửa đã cháy, quặng đã ở trong lò, nước đã ở trong máng; bác nhúng một miếng sắt của bác trước; An nhúng sắt quá sớm thì sắt cong, nhúng khi sắt đỏ rực thì sắt cứng.",
    "en": "The trial of the smith: the fire burns, the ore is in the forge, and the water is in the trough; the smith quenches one piece of his own first; An drops the iron too early and it bends, and drops it while it glows and it becomes hard."
  },
  "profile": {
    "name": "An",
    "grade": 1,
    "lang": "vi",
    "seed": 7,
    "flags": {
      "intro.seen": true,
      "prologue.started": true
    }
  },
  "clock": 540,
  "at": [
    "phu-dong",
    53,
    43
  ],
  "steps": [
    {
      "press": {
        "entity": "npc:smith"
      }
    },
    {
      "until": {
        "event": "open",
        "with": {
          "screen": "dialogue"
        },
        "timeout": 20
      }
    },
    {
      "read": true
    },
    {
      "expect": [
        {
          "text": {
            "shown": "dlg.smith.trial.n1"
          }
        },
        {
          "zone": "forge",
          "planks": ">= 2"
        },
        {
          "entity": "trough:smith",
          "look": "trough-full"
        },
        {
          "count": {
            "entities": "bucket",
            "max": 0
          }
        }
      ]
    },
    {
      "until": {
        "event": "call",
        "with": {
          "key": "smith.quench.watch"
        },
        "timeout": 10
      }
    },
    {
      "until": {
        "event": "hiss",
        "timeout": 30
      }
    },
    {
      "expect": [
        {
          "event": "call",
          "with": {
            "key": "smith.quench.show"
          }
        },
        {
          "event": "skill",
          "not": true
        }
      ]
    },
    {
      "until": {
        "event": "fire",
        "timeout": 10
      }
    },
    {
      "press": {
        "thing": "iron:smith"
      }
    },
    {
      "until": {
        "event": "bend",
        "timeout": 10
      }
    },
    {
      "expect": [
        {
          "event": "skill",
          "with": {
            "skill": "sci.matter.states",
            "solved": false,
            "first": true
          }
        }
      ]
    },
    {
      "wait": 4.5
    },
    {
      "press": true
    },
    {
      "until": {
        "event": "hiss",
        "timeout": 10
      }
    },
    {
      "expect": [
        {
          "event": "skill",
          "with": {
            "solved": true,
            "efficient": false
          }
        },
        {
          "entity": "iron:smith",
          "look": "blade"
        },
        {
          "flag": "trial.smith.done"
        },
        {
          "text": {
            "shown": "dlg.smith.trial.done.n1"
          }
        }
      ]

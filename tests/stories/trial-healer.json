{
  "name": "trial-healer",
  "about": {
    "vi": "Thử thách của bà lang: hái ba loại lá, mỗi loại hai bó, bỏ vào giỏ; thừa một bó thì bà trả lại, đủ thì bà nhận giỏ.",
    "en": "The trial of the healer: three kinds of leaves, two bunches of each, in the basket; one too many and she gives it back, just right and she takes the basket."
  },
  "profile": { "name": "An", "grade": 1, "lang": "vi", "seed": 7, "flags": { "intro.seen": true, "prologue.started": true } },
  "clock": 540,
  "at": ["phu-dong", 33, 44],
  "steps": [
    { "press": { "entity": "npc:healer" } },
    { "until": { "event": "open", "with": { "screen": "dialogue" }, "timeout": 20 } },
    { "read": true },
    { "expect": [{ "text": { "shown": "dlg.healer.trial.n1" } }, { "count": { "entities": "herb-ngai", "min": 7 } }] },
    { "repeat": 3, "steps": [{ "press": { "item": "herb-ngai" } }, { "until": { "event": "put", "timeout": 15 } }] },
    { "repeat": 2, "steps": [{ "press": { "item": "herb-tiato" } }, { "until": { "event": "put", "timeout": 15 } }] },
    { "repeat": 2, "steps": [{ "press": { "item": "herb-rauma" } }, { "until": { "event": "put", "timeout": 15 } }] },
    { "press": { "entity": "npc:healer" } },
    { "until": { "event": "nope", "timeout": 15 } },
    { "expect": [{ "event": "skill", "with": { "skill": "math.count.120", "solved": false, "parts": [3, 2, 2] } }, { "screen": null }] },
    { "press": { "entity": "npc:healer" } },
    { "until": { "event": "given", "timeout": 15 } },
    { "expect": [{ "event": "skill", "with": { "solved": true, "parts": [2, 2, 2] } }, { "flag": "trial.healer.done" }, { "text": { "shown": "dlg.healer.trial.done.n1" } }, { "entity": "basket:healer", "look": "basket-full" }] },
    { "read": true }
  ]
}

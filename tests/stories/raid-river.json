{
  "name": "raid-river",
  "about": {
    "vi": "Hai con thuồng luồng con bơi ngược sông về chỗ lội; em ném nắm cơm, mỗi con ăn hai nắm thì bình tĩnh lại và bơi đi.",
    "en": "Two little river serpents swim up the river to the ford; the child throws rice balls, and each one eats two, calms down, and swims away."
  },
  "profile": { "name": "An", "grade": 2, "lang": "vi", "seed": 4, "flags": { "intro.seen": true, "giong.spoke": true }, "items": { "coin": 5 } },
  "map": "phu-dong",
  "clock": 600,
  "place": [14, 61],
  "steps": [
    { "tap": { "entity": "encounter:river" } },
    { "until": { "event": "open", "with": { "screen": "say" }, "timeout": 20 } },
    { "expect": [{ "text": { "shown": "raid.river.intro" } }] },
    { "read": true },
    { "wait": 2 },
    { "expect": [{ "raid": { "on": true, "enemies": 1 } }, { "hero": { "cell": [18, 67.5], "within": 1 } }] },
    { "repeat": 18, "steps": [
      { "shoot": { "at": "first", "lead": 0.8, "wait": true } },
      { "wait": 1.4 }
    ] },
    { "until": { "event": "open", "with": { "screen": "say" }, "timeout": 40 } },
    { "expect": [{ "event": "retreat", "with": { "calm": true } }, { "event": "hit", "with": { "by": "riceball" } }, { "event": "end", "with": { "won": true } }, { "flag": "river.calmed" }, { "text": { "shown": "raid.river.note" } }] },
    { "read": [1] },
    { "expect": [{ "text": { "shown": "dlg.river.friends.n1" } }, { "screen": null }] }
  ]
}

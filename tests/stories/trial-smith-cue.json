{
  "name": "trial-smith-cue",
  "about": {
    "vi": "Gợi ý của bác thợ rèn: bác nhúng miếng sắt của bác trước (không có gợi ý trên miếng ấy); khi sắt của An đỏ rực mà An chờ, sắt phát sáng; An nhúng thì hết sáng.",
    "en": "The cue of the smith: he quenches his own piece first (no glow on it); when the iron of An glows hot and An waits, the iron glows; when An quenches it, the glow stops."
  },
  "profile": {
    "name": "An",
    "grade": 1,
    "lang": "vi",
    "seed": 7,
    "flags": {
      "intro.seen": true,
      "prologue.started": true
    }
  },
  "clock": 540,
  "at": [
    "phu-dong",
    53,
    43
  ],
  "steps": [
    {
      "press": {
        "entity": "npc:smith"
      }
    },
    {
      "until": {
        "event": "open",
        "with": {
          "screen": "dialogue"
        },
        "timeout": 20
      }
    },
    {
      "read": true
    },
    {
      "until": {
        "event": "hiss",
        "timeout": 30
      }
    },
    {
      "expect": [
        {
          "event": "call",
          "with": {
            "key": "smith.quench.show"
          }
        },
        {
          "event": "skill",
          "not": true
        }
      ]
    },
    {
      "until": {
        "event": "fire",
        "timeout": 10
      }
    },
    {
      "expect": [
        {
          "event": "cue",
          "with": {
            "ids": [
              "iron:smith-demo"
            ]
          },
          "not": true
        }
      ]
    },
    {
      "walk": {
        "to": [
          54.2,
          41.6
        ]
      }
    },
    {
      "do": {
        "type": "move",
        "dx": 0,
        "dz": 1,
        "strength": 1
      }
    },
    {
      "wait": 0.15
    },
    {
      "do": {
        "type": "move",
        "dx": 0,
        "dz": 0,
        "strength": 0
      }
    },
    {
      "until": {
        "event": "cue",
        "with": {
          "ids": [
            "iron:smith"
          ]
        },
        "timeout": 30
      }
    },
    {
      "press": true
    },
    {
      "until": {
        "event": "hiss",
        "timeout": 5
      }
    },
    {
      "expect": [
        {
          "event": "pulse",
          "with": {
            "id": "iron:smith"
          }
        },
        {
          "event": "cue",
          "with": {
            "ids": []
          }
        },
        {
          "flag": "trial.smith.done"
        }
      ]
    }
  ]

{
  "name": "staffs-bamboo",
  "about": {
    "vi": "Gậy tre cho trai làng: cháu chặt từng cây trong bụi tre ở tầm tay, khúc tre dài bằng chỗ chặt; khúc không bằng các khúc khác thì gãy và cây tre mọc lại; bốn khúc bằng nhau thì buộc thành bó gậy.",
    "en": "Bamboo staffs for the men of the village: the child slashes each culm of the clump at the height of the hand, and the piece is as long as the height of the cut; a piece that is not equal to the others breaks and its culm grows again; with four equal pieces, the staffs tie into a bundle."
  },
  "profile": { "name": "An", "grade": 2, "lang": "vi", "seed": 7, "flags": { "intro.seen": true, "prologue.started": true, "trial.woodcutter.done": true, "giong.grown": true, "soldier1.won": true, "soldier2.won": true } },
  "map": "phu-dong",
  "clock": 540,

    { "expect": [{ "event": "skill", "with": { "skill": "math.shapes", "solved": true, "first": false, "parts": [5, 5, 5, 5] } }, { "entity": "staffs:bamboo", "look": "staffs-4" }, { "flag": "boss.staffs" }, { "text": { "shown": "dlg.woodcutter.staffs.done.n1" } }] },

    { "tap": { "item": "stake" } },
    { "until": { "event": "pick", "timeout": 15 } },
    { "tap": { "line": 8 } },
    { "until": { "event": "put", "timeout": 15 } },
    { "tap": { "item": "stake" } },
    { "until": { "event": "pick", "timeout": 15 } },
    { "tap": { "line": 16 } },
    { "until": { "event": "put", "timeout": 15 } },
    { "until": { "event": "tide", "timeout": 90 } },
    { "expect": [{ "event": "skill", "with": { "skill": "math.add.20", "solved": false, "first": true, "parts": [4, 4, 8] } }] },
    { "until": { "event": "escape", "timeout": 5 } },
    { "expect": [{ "entity": "fish:fisher", "look": "fish-out" }, { "flag": "trial.fisher.done", "is": false }] },
    { "wait": 4 },
    { "tap": { "item": "stake" } },
    { "until": { "event": "pick", "timeout": 15 } },
    { "tap": { "line": 12 } },
    { "until": { "event": "put", "timeout": 15 } },
    { "until": { "event": "tide", "timeout": 90 } },
    { "expect": [{ "event": "skill", "with": { "solved": true, "first": false, "parts": [4, 4, 4, 4] } }] },
    { "until": { "event": "catch", "timeout": 5 } },
    { "until": { "event": "open", "with": { "screen": "dialogue" }, "timeout": 5 } },
    { "expect": [{ "flag": "trial.fisher.done" }, { "entity": "fish:fisher", "look": "fish-in" }, { "text": { "shown": "dlg.fisher.trial.done.n1" } }] },

{
  "name": "trial-fisher",
  "about": {
    "vi": "Thử thách của chú đánh cá: cắm cọc thành hàng trước khi triều lên; để một khe quá rộng thì cá thoát ra, cắm đủ thì cá ở lại trong đăng.",
    "en": "The trial of the fisher: stakes in a row before the tide; with a space too wide the fish swim out, and with the full row they stay in the trap."
  },
  "profile": { "name": "An", "grade": 1, "lang": "vi", "seed": 7, "flags": { "intro.seen": true, "prologue.started": true } },
  "clock": 540,
  "at": ["phu-dong", 27, 64.5],
  "steps": [
    { "tap": { "entity": "npc:fisher" } },

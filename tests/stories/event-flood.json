            "min": 5
          }
        }
      ]
    },
    {
      "repeat": 5,
      "steps": [
        {
          "press": {
            "item": "pails"
          }
        },
        {
          "until": {
            "event": "pick",
            "timeout": 30
          }
        },
        {
          "press": {
            "zone": "event-flood-place"
          }
        },
        {
          "until": {
            "event": "put",
            "timeout": 30
          }
        }
      ]
    },
    { "press": { "entity": "event:flood" } },
    {
      "until": {
        "event": "open",
        "with": {
          "screen": "say"
        },
        "timeout": 30
      }
    },
    {
      "expect": [
        {
          "text": {
            "shown": "event.flood.done"
          }
        },
        {
          "event": "skill",
          "with": {
            "solved": true,
            "target": 5,
            "first": true,
            "efficient": true
          }
        },
        {
          "event": "gift",
          "with": {
            "give": {

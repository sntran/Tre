{
  "name": "event-flood",
  "about": {
    "vi": "Mưa làm ngập một thửa ruộng: gánh đúng số thùng nước cô nông dân nói ra mương.",
    "en": "Rain flooded a field: carry as many pails of water to the ditch as the farmer says."
  },
  "profile": {
    "name": "An",
    "grade": 2,
    "lang": "vi",
    "seed": 7,
    "flags": {
      "intro.seen": true
    }
  },
  "clock": 540,
  "at": ["phu-dong", 57.5, 85.5],
  "steps": [
    {
      "do": {
        "type": "event",
        "id": "flood"
      }
    },
    {
      "wait": 0.5
    },
    {
      "press": {
        "entity": "event:flood"
      }
    },
    {
      "until": {
        "event": "open",
        "with": {
          "screen": "say"
        },
        "timeout": 30
      }
    },
    {
      "read": true
    },
    {
      "expect": [
        {
          "text": {
            "shown": "event.flood.start"
          }
        },
        {
          "count": {

{
  "name": "bridge",
  "about": {
    "vi": "Cây cầu gãy: đoán số tấm ván, rồi thử ngắn, dài, và vừa đủ; các cờ của mỗi lần bước lên cầu.",
    "en": "The broken bridge: the prediction, then a short, a long, and an exact bridge; the flags of each commit."
  },
  "profile": { "name": "An", "grade": 2, "lang": "vi", "seed": 7, "flags": { "intro.seen": true, "trial.fisher.done": true } },
  "clock": 540,
  "at": ["phu-dong", 46, 61],
  "steps": [
    { "until": { "event": "open", "with": { "screen": "dialogue" }, "timeout": 5 } },
    { "read": true },
    { "wait": 1 },
    { "expect": [{ "zone": "bridge-gap", "state": "open", "gap": 12, "planks": 0 }, { "count": { "entities": "plank-ghost", "min": 6 } }] },
    { "press": { "guess": 3 } },
    { "until": { "event": "guess", "timeout": 3 } },
    { "wait": 2 },
    { "press": { "plank": 4 } },
    { "until": { "event": "pick", "timeout": 20 } },
    { "press": { "screenOf": "bridge-gap" } },
    { "until": { "event": "put", "timeout": 20 } },
    { "wait": 1.5 },
    { "press": { "plank": 4 } },
    { "until": { "event": "pick", "timeout": 20 } },
    { "press": { "screenOf": "bridge-gap" } },
    { "until": { "event": "put", "timeout": 20 } },
    { "expect": [{ "zone": "bridge-gap", "planks": 2 }, { "event": "skill", "not": true }] },
    { "press": { "screenOf": "bridge-gap" } },
    { "until": { "event": "tip", "timeout": 20 } },
    { "expect": [
      { "event": "skill", "with": { "skill": "math.add.20", "solved": false, "first": true, "mashing": false, "evidence": true } },
      { "hero": { "falls": true } },
      { "event": "prediction", "with": { "guess": 3, "used": 2, "solved": false, "gap": 12 } }
    ] },
    { "until": { "event": "pulled", "timeout": 20 } },
    { "until": { "event": "float", "timeout": 15 } },
    { "wait": 2 },
    { "expect": [{ "hero": { "falls": false } }, { "zone": "bridge-gap", "planks": 1 }] },
    { "press": { "plank": 5 } },
    { "until": { "event": "pick", "timeout": 20 } },
    { "press": { "screenOf": "bridge-gap" } },
    { "until": { "event": "put", "timeout": 20 } },
    { "wait": 1.5 },
    { "press": { "plank": 5 } },
    { "until": { "event": "pick", "timeout": 20 } },
    { "press": { "screenOf": "bridge-gap" } },
    { "until": { "event": "long", "timeout": 20 } },
    { "expect": [{ "event": "call", "with": { "key": "world.bridge.long" } }, { "text": { "shown": "world.bridge.long" } }, { "event": "skill", "not": true }] },
    { "until": { "event": "float", "timeout": 15 } },
    { "wait": 1 },
    { "expect": [{ "zone": "bridge-gap", "planks": 2 }] },
    { "press": { "plank": 3 } },
    { "until": { "event": "pick", "timeout": 20 } },
    { "press": { "screenOf": "bridge-gap" } },
    { "until": { "event": "put", "timeout": 20 } },
    { "wait": 1 },
    { "press": { "screenOf": "bridge-gap" } },
    { "until": { "event": "solid", "timeout": 20 } },
    { "expect": [
      { "zone": "bridge-gap", "state": "solid" },
      { "event": "skill", "with": { "skill": "math.add.20", "solved": true, "first": false, "efficient": false, "mashing": false } },
      { "item": "fish", "count": ">= 1" }
    ] }
  ]
}
